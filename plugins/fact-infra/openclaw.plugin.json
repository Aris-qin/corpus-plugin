  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "fact_init",
      "fact_status",
      "fact_query",
      "fact_index",
      "fact_rebind",
      "fact_archive",
      "fact_goal_add",
      "fact_goal_update",
      "fact_phase_set",
      "fact_note_add",
      "fact_task_add",
      "fact_task_update",
      "fact_decision_add",
      "fact_decision_resolve",
      "fact_issue_open",
      "fact_issue_resolve",
      "fact_exp_log",
      "fact_journal_query",
      "fact_journal_upsert"
